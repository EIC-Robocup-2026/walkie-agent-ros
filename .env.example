# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Used by the `openai` vendor in config.toml. With the default config this is
# an OpenRouter key (https://openrouter.ai/keys).
OPENAI_API_KEY=

# Only needed if config.toml selects the `google` vendor.
# GOOGLE_API_KEY=

# Only needed when [tracing.langfuse] use_langfuse = true in config.toml.
# `pixi run langfuse-setup` fills these in for the local Langfuse server.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
