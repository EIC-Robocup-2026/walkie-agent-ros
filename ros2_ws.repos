# Every message package listed here must also be named in build-ros2's
# --packages-select in pixi.toml. A package missing there is not built, and
# the agent fails only when it imports it.
repositories:
  # HRIMessage and other RAI message types. Not published on RoboStack, so it
  # is built from source. Pinned to the main-branch commit RAI 2.12 tracks.
  ros2_ws/src/rai_interfaces:
    type: git
    url: https://github.com/RobotecAI/rai_interfaces.git
    version: f03dc0f217679980447dfead177979f485eb44f6
  # walkie_database_msgs, the messages of the memory node. The whole
  # repository is cloned; build-ros2 builds only the message package. Pin the
  # commit of the database node the robot runs: under rmw_zenoh_cpp, a client
  # built from another version of the interface finds the server, but its
  # requests are never answered (ADR-0035).
  ros2_ws/src/walkie-database:
    type: git
    url: https://github.com/EIC-Robocup-2026/walkie-database.git
    version: 7f657b0960944c4d4399ef19f5032b3c5d726f9d
  # walkie_vision_msgs, the messages of the vision nodes: people, objects and
  # the text-embedding service (ADR-0034). The whole repository is cloned;
  # build-ros2 builds only the message package. Pin the commit the vision
  # nodes on the robot are built from, for the same reason as walkie-database.
  ros2_ws/src/walkie-vision:
    type: git
    url: https://github.com/EIC-Robocup-2026/walkie-vision.git
    version: b050ea107ef5f22ba8cc3bcfb83212d70cb8bb96
