# Every message package listed here must also be named in build-ros2's
# --packages-select in pixi.toml. A package missing there is not built, and
# the agent fails only when it imports it.
repositories:
  # HRIMessage and other RAI message types. Not published on RoboStack, so it
  # is built from source. Pinned to the main-branch commit RAI 2.12 tracks.
  ros2_ws/src/rai_interfaces:
    type: git
    url: https://github.com/RobotecAI/rai_interfaces.git
    version: f03dc0f217679980447dfead177979f485eb44f6
  # walkie_database_msgs, the messages of the memory node: FindObjects and
  # RememberedObject for find_objects, and the people services start_session,
  # end_session, remember_person, match_faces and match_appearances.
  # FindObjects and RememberedObject type hashes are unchanged from 7f657b0
  # (ADR-0035). The whole repository is cloned; build-ros2 builds only the
  # message package. Pin the commit of the database node the robot runs:
  # under rmw_zenoh_cpp, a client built from another version of the
  # interface finds the server, but its requests are never answered
  # (ADR-0035).
  ros2_ws/src/walkie-database:
    type: git
    url: https://github.com/EIC-Robocup-2026/walkie-database.git
    version: 64403e982e253db0ca00c372249eeb798d89d1f6
  # walkie_vision_msgs, the messages of the vision node: people, objects and
  # the text-embedding service (ADR-0034). walkie-vision runs every model in
  # one process, its vision node. The whole repository is cloned; build-ros2
  # builds only the message package. Pin the commit the vision node on the
  # robot is built from, for the same reason as walkie-database. The messages
  # are unchanged from b050ea1.
  ros2_ws/src/walkie-vision:
    type: git
    url: https://github.com/EIC-Robocup-2026/walkie-vision.git
    version: 1576d6f979e9513c9d2e9b752232341f01a5bc0a
  # my_robot_interfaces, the interfaces of the arm commander:
  # SetJointPosition, ControlGripper and GetJointStates (ADR-0018, ADR-0021).
  # The type names must match walkie-ros exactly, so the package is built from
  # this clone rather than copied under another name. The whole repository is
  # cloned; build-ros2 builds only my_robot_interfaces. It is a full clone: it
  # downloads about 115 MB, every branch's objects with the MuJoCo world
  # assets included, and takes about 250 MB on disk with the checked-out
  # files, which is acceptable for a clone made once. config/robot_model.toml
  # is generated from this clone and a test compares them (ADR-0022). Move the
  # pin when the commander's interface changes, for the same reason as
  # walkie-database. This is origin/main of 2026-10-23, the commit the
  # simulation check used; ADR-0018 asks for the commit on the robot PC, so
  # compare the two before the first robot run.
  ros2_ws/src/walkie-ros:
    type: git
    url: https://github.com/EIC-Robocup-2026/walkie-ros.git
    version: 6b26daab15d935a19621e51ebe8c10d81a3d8224
